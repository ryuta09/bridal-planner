---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import "../styles/style.scss";
const { title } = Astro.props;
import { SEO } from "astro-seo";
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tsukimi+Rounded&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css" />
    <SEO
      title={title}
      description="簡単なプロフィールと自分がアウトプットしているブログを一覧として掲載しているポートフォリオです。お問い合わせも受け付けてます。"
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: "/assets/images/SEO.webp",
        },
      }}
      twitter={{
        creator: "@gdk0918",
      }},
      extend={{
        link: [{ rel: "icon", href: "/favicon.ico" }],
        meta: [
          {
            name: "twitter:image",
            content: "/assets/images/SEO.webp",
          },
          { name: "twitter:title", content: "ポートフォリオ" },
          { name: "twitter:description", content: "簡単なプロフィールと自分がアウトプットしているブログを一覧として掲載しているポートフォリオです。お問い合わせも受け付けてます。" },
        ],
      }}
    />
  </head>
  <body>
    <Header />
    <main class="l-main">
      <slot />
    </main>
    <Footer />
    <script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js"></script>
    <script type="module" src="/assets/js/index.js"></script>
    
  </body>
</html>
